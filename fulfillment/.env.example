PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=set-in-host-secret-manager
PAYPAL_CLIENT_SECRET=set-in-host-secret-manager
PAYPAL_RETURN_URL=https://myclinicprotocols.com/checkout-return.html
PAYPAL_CANCEL_URL=https://myclinicprotocols.com/order.html?checkout=cancelled
DOWNLOAD_SIGNING_SECRET=generate-a-long-random-secret
PUBLIC_API_URL=https://orders.myclinicprotocols.com
WEBSITE_ORIGIN=https://myclinicprotocols.com
RESEND_API_KEY=set-in-host-secret-manager
ORDER_FROM_EMAIL=MyClinicProtocols <orders@myclinicprotocols.com>

# Supabase server-side persistence. Keep the secret key only in Render.
SUPABASE_URL=https://vkpeqhelklthkuorczdj.supabase.co
SUPABASE_SERVICE_ROLE_KEY=set-in-host-secret-manager
SUPABASE_STORAGE_BUCKET=order-packages

# Local fallback only. Supabase Storage is the durable package store.
MYCP_PRIVATE_ROOT=/data
